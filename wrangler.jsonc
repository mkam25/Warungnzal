{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "warungnzal",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/admin",
      "/admin/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "warungnzal",
      "database_id": "c9af74d8-6981-44b6-ba36-21dd02835d0f"
    }
  ]
}
