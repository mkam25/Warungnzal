{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "warungnzal",
  "main": "src/index.js",
  "compatibility_date": "2026-09-23",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "warungnzal",
      "database_id": "REPLACE_WITH_YOUR_D1_ID"
    }
  ]
}